# Rain.gg affiliate API key, sent as the x-api-key header. Server-only.
# Issued from the Rain.gg affiliate dashboard.
RAIN_API_KEY=

# Unbox.gg affiliate token, from the affiliate dashboard. Sent as ?token= to
# its public applicants endpoint. Server-only.
UNBOX_TOKEN=

# Past leaderboards. Connect a Blob store to the project in Vercel (Storage ->
# Blob) and it sets BLOB_READ_WRITE_TOKEN for you. Without it, finished races
# are not kept and no past races show. BLOB_ACCESS (public|private) is optional:
# the site works it out on first use.
BLOB_READ_WRITE_TOKEN=

# Any long random string. Vercel's cron sends it to /api/archive, and on Vercel
# that route refuses every caller without it.
CRON_SECRET=

# Canonical origin, e.g. https://mocker-en.com
NEXT_PUBLIC_SITE_URL=
