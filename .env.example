# Rain.gg affiliate API key, sent as the x-api-key header. Server-only.
# Issued from the Rain.gg affiliate dashboard.
RAIN_API_KEY=

# Unbox.gg affiliate token, from the affiliate dashboard. Sent as ?token= to
# its public applicants endpoint. Server-only.
UNBOX_TOKEN=

# Canonical origin, e.g. https://mocker-en.com
NEXT_PUBLIC_SITE_URL=
