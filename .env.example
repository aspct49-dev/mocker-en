# Rain.gg affiliate API key, sent as the x-api-key header. Server-only.
# Issued from the Rain.gg affiliate dashboard.
RAIN_API_KEY=

# CaseBattle deal "public leaderboard password", from the deal dashboard on
# casebattle.com. Sent as ?password= to the deal leaderboard. Server-only.
CASEBATTLE_LEADERBOARD_PASSWORD=

# Canonical origin, e.g. https://mocker-en.com
NEXT_PUBLIC_SITE_URL=
